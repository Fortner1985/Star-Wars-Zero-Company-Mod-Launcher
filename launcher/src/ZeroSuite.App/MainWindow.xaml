<Window x:Class="ZeroSuite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroSuite" Height="760" Width="1180"
        Background="{StaticResource Ground}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Install -->
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="ZeroSuite" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="PathText" Foreground="{StaticResource Muted}"
                 FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Health -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="6"
            Padding="14" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="RUNTIME HEALTH" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
        <ItemsControl x:Name="HealthList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="4" CornerRadius="2"
                        Background="{Binding Accent}" VerticalAlignment="Stretch"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}"
                             FontSize="12" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Remedy}" Foreground="{StaticResource Warn}"
                             FontSize="12" TextWrapping="Wrap"
                             Visibility="{Binding RemedyVisibility}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Toggles -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="1.15*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="6"
              Padding="14" Margin="0,0,7,0">
        <StackPanel>
          <TextBlock Text="MODS" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ModList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                            IsEnabled="{Binding Editable}">
                    <TextBlock Text="{Binding Name}"/>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="6"
              Padding="14" Margin="7,0,7,0">
        <StackPanel>
          <TextBlock Text="ZEROCAM FIXES" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource Muted}" Margin="0,0,0,2"/>
          <TextBlock Text="clip_through and floaty_controls apply. cut_plane is read-only. The rest are stubs that apply nothing."
                     FontSize="11" Foreground="{StaticResource Warn}"
                     TextWrapping="Wrap" Margin="0,0,0,8"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="FixList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,6">
                    <CheckBox IsChecked="{Binding Value, Mode=TwoWay}">
                      <TextBlock Text="{Binding Key}" FontFamily="Consolas"/>
                    </CheckBox>
                    <TextBlock Text="{Binding Description}" FontSize="11"
                               Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="24,0,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="6"
              Padding="14" Margin="7,0,0,0">
        <StackPanel>
          <TextBlock Text="DISPLAY AND PERFORMANCE" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource Muted}" Margin="0,0,0,2"/>
          <TextBlock x:Name="DisplayNote"
                     FontSize="11" Foreground="{StaticResource Warn}"
                     TextWrapping="Wrap" Margin="0,0,0,8"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DisplayList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,10">
                    <CheckBox IsChecked="{Binding Value, Mode=TwoWay}">
                      <TextBlock Text="{Binding Key}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock Text="{Binding Description}" FontSize="11"
                               Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="24,2,0,0"/>
                    <TextBlock Text="{Binding Detail}" FontSize="10.5"
                               FontFamily="Consolas" Foreground="#7F868C"
                               TextWrapping="Wrap" Margin="24,2,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Actions -->
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <TextBlock Text="Dump game data:" VerticalAlignment="Center"
                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,8,0"/>
        <Button x:Name="DumpObjectsButton" Content="Objects" Padding="12,6" Margin="0,0,6,0"
                Click="OnDumpObjects"/>
        <Button x:Name="DumpUsmapButton" Content="Mappings" Padding="12,6" Margin="0,0,6,0"
                Click="OnDumpUsmap"/>
        <TextBlock x:Name="BridgeText" VerticalAlignment="Center" MaxWidth="420"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0"/>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                 Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,14,0"/>
      <Button x:Name="RefreshButton" Content="Re-check" Padding="14,7" Margin="0,0,8,0"
              Click="OnRefresh"/>
      <Button x:Name="ApplyButton" Content="Apply changes" Padding="14,7"
              Click="OnApply"/>
    </StackPanel>
  </Grid>
</Window>
